## Frontend environment variables (example)
#
# Copy to `.env` locally (do NOT commit real keys to git).

# Backend API base URL
# For localhost only: http://localhost:5001/api
# For network access: http://YOUR_LOCAL_IP:5001/api (e.g., http://192.168.29.143:5001/api)
VITE_API_BASE_URL=http://localhost:5001/api

